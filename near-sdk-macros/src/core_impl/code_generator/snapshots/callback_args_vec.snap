                ::near_sdk::serde_json::from_slice(&__near_data)
                    .unwrap_or_else(|__near_e| ::near_sdk::env::panic_str(
                        &format!(
                            "Failed to deserialize callback using JSON. Error: `{__near_e}`"
                        ),
                    ))
            },
        ),
    );
    let __near_contract = <Hello as ::near_sdk::state::ContractState>::state_read()
        .unwrap_or_default();
    Hello::method(&__near_contract, x, y);
