#[cfg(target_arch = "wasm32")]
#[unsafe(no_mangle)]
pub extern "C" fn method() {
    ::near_sdk::env::setup_panic_hook();
    if ::near_sdk::env::attached_deposit().as_yoctonear() != 0 {
        ::near_sdk::env::panic_str("Method method doesn't accept deposit");
    }
    #[derive(::near_sdk::borsh::BorshDeserialize)]
    #[borsh(crate = "::near_sdk::borsh")]
    struct Input {
        k: u64,
        m: Bar,
    }
    let Input { k, m }: Input = match ::near_sdk::env::input() {
        Some(__near_input) => {
            match ::near_sdk::borsh::BorshDeserialize::try_from_slice(&__near_input) {
                Ok(__near_deserialized) => __near_deserialized,
                Err(__near_e) => {
                    ::near_sdk::env::panic_str(
                        &format!(
                            "Failed to deserialize input from Borsh. Error: `{__near_e}`"
                        ),
                    );
                }
            }
        }
        None => ::near_sdk::env::panic_str("Expected input since method has arguments."),
    };
    let mut __near_contract = <Hello as ::near_sdk::state::ContractState>::state_read()
        .unwrap_or_default();
    let __near_result = Hello::method(&mut __near_contract, k, m);
    let __near_result = match near_sdk::borsh::to_vec(&__near_result) {
        Ok(__near_v) => __near_v,
        Err(_) => {
            ::near_sdk::env::panic_str(
                "Failed to serialize the return value using Borsh.",
            )
        }
    };
    ::near_sdk::env::value_return(&__near_result);
    <Hello as ::near_sdk::state::ContractState>::state_write(&__near_contract);
}
